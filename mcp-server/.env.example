# ===== 对外：Agent 访问本 MCP server =====
# 外部 Agent 访问 /mcp 端点时的 Bearer 密钥，请使用强随机串（如 openssl rand -hex 32）
MCP_API_KEY=your_mcp_api_key_here

# 本服务监听端口
MCP_PORT=4002

# ===== 对内：本 MCP server 访问博客后端 =====
# 博客 API 地址。生产：https://hanphone.cn/api ；本地联调：http://localhost:8090
BLOG_API_BASE_URL=https://hanphone.cn/api

# 内部接口密钥，必须与 server/.env 中的 INTERNAL_API_KEY 完全一致（否则写工具不可用）
INTERNAL_API_KEY=your_internal_api_key_here

# 创建内容时的作者身份（管理员用户 ID，可用 list_users 工具查询）
MCP_AUTHOR_ID=

# 管理员回复留言时的显示昵称
MCP_AUTHOR_NICKNAME=寒枫
