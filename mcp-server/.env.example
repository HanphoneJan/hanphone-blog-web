# ===== 本服务监听与连接 =====
MCP_PORT=4002

# ===== 对内：本 MCP server 访问博客后端 =====
# 博客 API 地址。生产：https://hanphone.cn/api ；本地联调：http://localhost:8090
BLOG_API_BASE_URL=https://hanphone.cn/api

# 内部接口密钥，必须与 server/.env 中的 INTERNAL_API_KEY 完全一致
# MCP server 用它向后端校验每个 Agent 提交的 MCP API Key
INTERNAL_API_KEY=your_internal_api_key_here

# 创建内容时的作者身份（管理员用户 ID），可用 list_users 工具查询后填回
# 随笔创建强制要求该字段
MCP_AUTHOR_ID=

# 管理员回复留言时的显示昵称
MCP_AUTHOR_NICKNAME=博主

# Agent Bearer 密钥校验缓存 TTL（毫秒），默认 60000（60s）。
# 同一 valid=false 会被缓存 TTL 时段，防止恶意轮询压后端。
# MCP_VERIFY_CACHE_TTL_MS=60000
